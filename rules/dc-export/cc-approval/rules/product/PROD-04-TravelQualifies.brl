<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>PROD-04-TravelQualifies</name>
  <uuid>e95cdd47-c348-5569-a558-eec2b2b5c6d9</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the requested product of 'the application' is TRAVEL_INFINITE
    and the annual income of the employment of 'the application' is at least 80000
    and the bureau score of the bureau report of 'the application' is at least 720
then
    set the product of 'the decision' to TRAVEL_INFINITE ;
    record that rule "PROD-04" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
