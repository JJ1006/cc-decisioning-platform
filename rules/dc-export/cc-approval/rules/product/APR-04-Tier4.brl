<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>APR-04-Tier4</name>
  <uuid>368c4598-74b8-5ee6-9d3b-378bf8c0d115</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the bureau score of the bureau report of 'the application' is at most 649
then
    set the APR tier of 'the decision' to TIER_4 ;
    record that rule "APR-04" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
