<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>APR-02-Tier2</name>
  <uuid>9683a886-c575-5002-951f-3c93a6a68f1d</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the bureau score of the bureau report of 'the application' is at least 680
    and the bureau score of the bureau report of 'the application' is at most 739
then
    set the APR tier of 'the decision' to TIER_2 ;
    record that rule "APR-02" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
