<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>RSN-01-ApprovedStandard</name>
  <uuid>9701990b-01d5-53c1-9c8d-bae5fe30f3dd</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the outcome of 'the decision' is null
then
    escalate 'the decision' to APPROVE ;
    add reason code R_APPROVED_STANDARD to 'the decision' ;
    record that rule "RSN-01" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
