<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>RISK-01-MinimumIncome</name>
  <uuid>5db6fec1-e54d-51de-b267-fec919a09c97</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the annual income of the employment of 'the application' is less than 15000
then
    add reason code R_INSUFFICIENT_INCOME to 'the decision' ;
    escalate 'the decision' to DECLINE ;
    record that rule "RISK-01" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
