<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>RISK-02-Delinquencies</name>
  <uuid>02b8a7cd-d2f8-561b-82bc-cc72fbb43336</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the delinquencies of the bureau report of 'the application' is at least 3
then
    add reason code R_DELINQUENCIES to 'the decision' ;
    escalate 'the decision' to DECLINE ;
    record that rule "RISK-02" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
