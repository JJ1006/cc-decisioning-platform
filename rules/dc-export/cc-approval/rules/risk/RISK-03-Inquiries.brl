<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>RISK-03-Inquiries</name>
  <uuid>f9aa4b83-5169-5618-80e9-654d45bd6a1a</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the inquiries in the last 6 months of the bureau report of 'the application' is more than 6
then
    add reason code R_EXCESSIVE_INQUIRIES to 'the decision' ;
    escalate 'the decision' to DECLINE ;
    record that rule "RISK-03" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
