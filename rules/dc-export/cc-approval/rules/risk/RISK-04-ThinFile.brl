<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>RISK-04-ThinFile</name>
  <uuid>7b8ff3ed-7312-5203-94a9-98996a094c3e</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the file age in months of the bureau report of 'the application' is less than 6
then
    add reason code R_THIN_FILE to 'the decision' ;
    escalate 'the decision' to REFER ;
    record that rule "RISK-04" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
