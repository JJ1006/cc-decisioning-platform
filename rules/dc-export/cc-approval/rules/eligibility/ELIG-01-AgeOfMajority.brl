<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>ELIG-01-AgeOfMajority</name>
  <uuid>d6ba2670-a230-5f3d-8fd1-9cb9e6e48dd2</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the age in years of the applicant of 'the application' is less than the age of majority of the province of the address of 'the application'
then
    add reason code R_AGE_BELOW_MAJORITY to 'the decision' ;
    escalate 'the decision' to DECLINE ;
    record that rule "ELIG-01" fired in 'the decision' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
