# Copy to .env and edit. Placeholders only - never commit real values.
COMPOSE_PROJECT_NAME=ccplatform
PKI_PASSWORD=changeit
# ODM for Developers ships fixed demo users (odmAdmin/odmAdmin, resAdmin/resAdmin, rtsAdmin/rtsAdmin).
# Container memory for ODM (docker compose mem_limit); 2560m is comfortable, 2g is the floor.
ODM_MEM=2560m
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me
# Optional: only for `make eval-agent`
ANTHROPIC_API_KEY=
