    {
      "type": "table",
      "title": "Traces of the orchestrator slower than 300 ms",
      "description": "TraceQL: click a trace id to open the waterfall (gateway, application-api, Kafka, orchestrator, ODM, notification).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"decision-orchestrator\" && duration > 300ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      }
    }
  ]
