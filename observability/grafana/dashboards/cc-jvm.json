      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (jvm_memory_used_bytes{job=\"spring\",area=\"heap\"})",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
