{
  "uid": "cc-business",
  "title": "Business metrics (mini)",
  "description": "A small business view from the orchestrator's Micrometer counters: no personal data, labels are outcome, product and province only. The full business analytics are in Kibana.",
  "tags": [
    "maple-northern",
    "business"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Observability guide",
      "type": "link",
      "url": "https://localhost:3000/dashboards?tag=maple-northern",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Approval rate (1h)",
      "description": "Approved divided by all automated decisions, last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(decisions_total{outcome=\"APPROVE\"}[1h])) / sum(increase(decisions_total[1h]))",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
