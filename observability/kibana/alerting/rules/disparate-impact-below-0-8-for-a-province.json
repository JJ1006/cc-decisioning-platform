{
  "id": "6d6f2f5e-0a6c-4f0a-9d10-4d4e5c000105",
  "name": "Disparate impact below 0.8 for a province (24h, n >= 30)",
  "tags": [
    "maple-northern"
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts",
  "schedule": {
    "interval": "15m"
  },
  "params": {
    "searchType": "esqlQuery",
    "timeField": "@timestamp",
    "timeWindowSize": 24,
    "timeWindowUnit": "h",
    "thresholdComparator": ">",
    "threshold": [
      0
    ],
    "size": 100,
    "excludeHitsFromPreviousRun": false,
    "esqlQuery": {
      "esql": "FROM cc-decisions | WHERE decisionSource == \"ODM\" AND @timestamp >= NOW() - 24 hours | EVAL approved = CASE(payload.outcome == \"APPROVE\", 1.0, 0.0) | INLINESTATS overall = AVG(approved) | STATS n = COUNT(*), rate = AVG(approved), overall = MAX(overall) BY grp = payload.applicantSummary.province | WHERE n >= 30 AND overall > 0 AND rate / overall < 0.8"
    },
    "aggType": "count",
    "groupBy": "all"
  },
  "actions": [
    {
      "group": "query matched",
      "id": "6d6f2f5e-0a6c-4f0a-9d10-4d4e5c000001",
      "params": {
        "level": "warn",
        "message": "[{{rule.name}}] {{context.message}}"
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    },
    {
      "group": "query matched",
      "id": "6d6f2f5e-0a6c-4f0a-9d10-4d4e5c000002",
      "params": {
        "documents": [
          {
            "@timestamp": "{{date}}",
            "rule": "{{rule.name}}",
            "ruleId": "{{rule.id}}",
            "alertId": "{{alert.id}}",
            "status": "fired",
            "severity": "warning",
            "message": "{{context.message}}"
          }
        ]
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    }
  ]
}
