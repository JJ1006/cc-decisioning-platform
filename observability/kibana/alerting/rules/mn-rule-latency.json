{
  "id": "mn-rule-latency",
  "name": "Decision latency p95 above 300 ms",
  "tags": [
    "maple-northern"
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts",
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchType": "esqlQuery",
    "timeField": "@timestamp",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [
      0
    ],
    "size": 100,
    "excludeHitsFromPreviousRun": false,
    "esqlQuery": {
      "esql": "FROM cc-decisions | WHERE decisionSource == \"ODM\" | STATS p95 = PERCENTILE(payload.processingMillis, 95), n = COUNT(*) | WHERE n >= 5 AND p95 > 300"
    }
  },
  "actions": [
    {
      "group": "query matched",
      "id": "mn-server-log",
      "params": {
        "level": "warn",
        "message": "[{{rule.name}}] {{context.message}}"
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    },
    {
      "group": "query matched",
      "id": "mn-cc-alerts",
      "params": {
        "documents": [
          {
            "@timestamp": "{{date}}",
            "rule": "{{rule.name}}",
            "ruleId": "{{rule.id}}",
            "alertId": "{{alert.id}}",
            "status": "fired",
            "severity": "warning",
            "message": "{{context.message}}"
          }
        ]
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    }
  ]
}
