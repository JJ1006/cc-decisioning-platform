      "properties": {
        "eventId": {
          "type": "keyword"
        },
        "correlationId": {
          "type": "keyword"
        },
        "eventType": {
          "type": "keyword"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "occurredAt": {
          "type": "date"
        },
        "producer": {
          "type": "keyword"
        },
        "topic": {
          "type": "keyword"
        },
        "payload": {
