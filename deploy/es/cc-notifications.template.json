          "dynamic": "strict",
          "properties": {
            "applicationId": {
              "type": "keyword"
            },
            "noticeType": {
              "type": "keyword"
            },
            "channel": {
              "type": "keyword"
            },
            "recipientRef": {
              "type": "keyword"
            },
            "subject": {
              "type": "text"
            },
            "body": {
              "type": "text"
            },
            "reasonTexts": {
              "type": "text"
            }
          }
        }
