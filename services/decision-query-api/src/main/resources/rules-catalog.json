{
  "source": "docs/rules-catalog.md",
  "rules": [
    {
      "id": "ELIG-01",
      "package": "eligibility",
      "intent": "Contract capacity",
      "condition": "age in years < age of majority of the applicant's province",
      "action": "DECLINE",
      "reasonCodes": [
        "R_AGE_BELOW_MAJORITY"
      ],
      "severity": 3
    },
    {
      "id": "ELIG-02",
      "package": "eligibility",
      "intent": "Residency",
      "condition": "residency status is NON_RESIDENT or WORK_PERMIT_EXPIRED",
      "action": "DECLINE",
      "reasonCodes": [
        "R_NON_RESIDENT"
      ],
      "severity": 3
    },
    {
      "id": "ELIG-03",
      "package": "eligibility",
      "intent": "No active insolvency",
      "condition": "bureau reports an active bankruptcy",
      "action": "DECLINE",
      "reasonCodes": [
        "R_ACTIVE_BANKRUPTCY"
      ],
      "severity": 3
    },
    {
      "id": "RISK-01",
      "package": "risk",
      "intent": "Minimum income",
      "condition": "annual income < 15,000",
      "action": "DECLINE",
      "reasonCodes": [
        "R_INSUFFICIENT_INCOME"
      ],
      "severity": 3
    },
    {
      "id": "RISK-02",
      "package": "risk",
      "intent": "Payment history",
      "condition": "delinquencies (24 months) >= 3",
      "action": "DECLINE",
      "reasonCodes": [
        "R_DELINQUENCIES"
      ],
      "severity": 3
    },
    {
      "id": "RISK-03",
      "package": "risk",
      "intent": "Credit-seeking behaviour",
      "condition": "hard inquiries (6 months) > 6",
      "action": "DECLINE",
      "reasonCodes": [
        "R_EXCESSIVE_INQUIRIES"
      ],
      "severity": 3
    },
    {
      "id": "RISK-04",
      "package": "risk",
      "intent": "Enough history to assess",
      "condition": "file age < 6 months",
      "action": "REFER",
      "reasonCodes": [
        "R_THIN_FILE"
      ],
      "severity": 2
    },
    {
      "id": "RISK-DT-01",
      "package": "risk",
      "intent": "Score x debt service (decision table `ScoreTdsOutcome`)",
      "condition": "see table below",
      "action": "DECLINE / REFER / none",
      "reasonCodes": [
        "R_LOW_SCORE",
        "R_HIGH_TDS",
        "R_BORDERLINE_SCORE",
        "R_BORDERLINE_TDS"
      ],
      "severity": 3
    },
    {
      "id": "LIM-DT-01",
      "package": "limit",
      "intent": "Base limit by income and score (decision table `IncomeScoreLimit`)",
      "condition": "see table below",
      "action": "set credit limit",
      "reasonCodes": [],
      "severity": 0
    },
    {
      "id": "LIM-02",
      "package": "limitcap",
      "intent": "Never exceed what was asked for",
      "condition": "credit limit > requested limit (requested limit is mandatory input)",
      "action": "credit limit = requested limit",
      "reasonCodes": [],
      "severity": 0
    },
